{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashboardLayout",
  "type": "object",
  "required": ["panels"],
  "properties": {
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["kpi_strip", "stock_alerts", "transfers", "recent_activity", "sales", "inventory"]
          },
          "position": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": {"type": "integer"},
              "y": {"type": "integer"},
              "w": {"type": "integer"},
              "h": {"type": "integer"}
            }
          },
          "settings": {"type": "object"}
        }
      },
      "minItems": 1,
      "maxItems": 20
    }
  }
}
